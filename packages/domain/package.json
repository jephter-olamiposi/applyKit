{
  "name": "@applykit/domain",
  "version": "0.1.0",
  "description": "Domain entities, candidate profile model, evidence system, and action protocols for ApplyKit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pdf-exporter": {
      "types": "./dist/tailoring/pdf-exporter.d.ts",
      "import": "./dist/tailoring/pdf-exporter.js"
    },
    "./docx-exporter": {
      "types": "./dist/tailoring/docx-exporter.d.ts",
      "import": "./dist/tailoring/docx-exporter.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "applykit",
    "domain",
    "job-search",
    "browser-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "docx": "^9.8.1",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "jszip": "^3.10.2"
  }
}
