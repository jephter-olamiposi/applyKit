{
  "name": "applykit",
  "version": "0.1.0",
  "description": "ApplyKit - Local-first, privacy-respecting browser extension and engine for job applications",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "vitest run",
    "package": "node scripts/package-extension.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jephter-olamiposi/applyKit.git"
  },
  "keywords": [
    "applykit",
    "job-applications",
    "local-first",
    "privacy",
    "browser-extension"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.9",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
